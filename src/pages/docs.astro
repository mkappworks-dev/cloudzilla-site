---
import LandingLayout from '../layouts/LandingLayout.astro';
import Nav from '../components/landing/Nav.astro';
import Footer from '../components/landing/Footer.astro';
import CodeBlock from '../components/docs/CodeBlock.astro';
import { LINKS } from '../consts';
import '../styles/docs.css';

// Code snippets: `copy` is the raw clipboard text, `html` is the
// syntax-span markup injected via set:html. Defined here (JS strings) so
// literal braces — e.g. the Caddyfile — never collide with Astro's `{ }`.
const cbDocker = {
  copy: `docker run -d --name cloudzilla \\
  -p 3000:3000 -p 22:22 \\
  -e DATABASE_URL=postgres://cz:secret@db:5432/cloudzilla \\
  -e CLOUDZILLA_BASE_URL=https://git.example.com \\
  ghcr.io/mkappworks-dev/cloudzilla-app:v0.3.0`,
  html: `<span class="c-prompt">$</span> docker run -d <span class="c-flag">--name</span> cloudzilla <span class="c-flag">\\</span>
    <span class="c-flag">-p</span> 3000:3000 <span class="c-flag">-p</span> 22:22 <span class="c-flag">\\</span>
    <span class="c-flag">-e</span> DATABASE_URL=<span class="c-str">postgres://cz:secret@db:5432/cloudzilla</span> <span class="c-flag">\\</span>
    <span class="c-flag">-e</span> CLOUDZILLA_BASE_URL=<span class="c-str">https://git.example.com</span> <span class="c-flag">\\</span>
    ghcr.io/mkappworks-dev/cloudzilla-app:v0.3.0

<span class="c-comment"># open http://localhost:3000 — migrations run automatically</span>`,
};

const cbCompose = {
  copy: `services:
  cloudzilla:
    image: ghcr.io/mkappworks-dev/cloudzilla-app:v0.3.0
    ports: ["3000:3000", "22:22"]
    environment:
      DATABASE_URL: postgres://cz:secret@db:5432/cloudzilla
      CLOUDZILLA_BASE_URL: https://git.example.com
    depends_on: [db]
  db:
    image: postgres:16
    environment:
      POSTGRES_USER: cz
      POSTGRES_PASSWORD: secret
      POSTGRES_DB: cloudzilla
    volumes: ["czdata:/var/lib/postgresql/data"]
volumes:
  czdata:`,
  html: `<span class="c-comment">services:</span>
  cloudzilla:
    image: ghcr.io/mkappworks-dev/cloudzilla-app:v0.3.0
    ports: [<span class="c-str">"3000:3000"</span>, <span class="c-str">"22:22"</span>]
    environment:
      DATABASE_URL: <span class="c-str">postgres://cz:secret@db:5432/cloudzilla</span>
      CLOUDZILLA_BASE_URL: <span class="c-str">https://git.example.com</span>
    depends_on: [db]
  db:
    image: postgres:16
    environment:
      POSTGRES_USER: cz
      POSTGRES_PASSWORD: secret
      POSTGRES_DB: cloudzilla
    volumes: [<span class="c-str">"czdata:/var/lib/postgresql/data"</span>]
volumes:
  czdata:`,
};

const cbBinary = {
  copy: `curl -fsSL https://github.com/mkappworks-dev/cloudzilla-app/releases/download/v0.3.0/cloudzilla-linux-amd64 -o cloudzilla
chmod +x cloudzilla
DATABASE_URL=postgres://localhost/cloudzilla ./cloudzilla serve`,
  html: `<span class="c-prompt">$</span> curl <span class="c-flag">-fsSL</span> https://github.com/mkappworks-dev/cloudzilla-app/releases/download/v0.3.0/cloudzilla-linux-amd64 <span class="c-flag">-o</span> cloudzilla
<span class="c-prompt">$</span> chmod +x cloudzilla
<span class="c-prompt">$</span> DATABASE_URL=<span class="c-str">postgres://localhost/cloudzilla</span> ./cloudzilla serve`,
};

const cbSsh = {
  copy: `git clone git@git.example.com:acme/forge.git`,
  html: `<span class="c-prompt">$</span> git clone git@git.example.com:acme/forge.git`,
};

const cbHttps = {
  copy: `git clone https://git.example.com/acme/forge.git`,
  html: `<span class="c-prompt">$</span> git clone https://git.example.com/acme/forge.git
<span class="c-comment"># username: your handle · password: a personal access token</span>`,
};

const cbCaddy = {
  copy: `git.example.com {
    reverse_proxy localhost:3000
}`,
  html: `git.example.com {
    reverse_proxy localhost:3000
}`,
};

const cbBackup = {
  copy: `pg_dump cloudzilla | gzip > cloudzilla-$(date +%F).sql.gz`,
  html: `<span class="c-prompt">$</span> pg_dump cloudzilla | gzip &gt; cloudzilla-<span class="c-str">$(date +%F)</span>.sql.gz`,
};

const description =
  'Documentation for Cloudzilla — a minimal, self-hosted Git forge. Install, configure, and operate a single-binary forge backed by PostgreSQL.';
---
<LandingLayout title="Docs" description={description}>
  <Nav />

  <main id="main">
    <div class="wrap">
      <div class="docs">

        <!-- left: section nav -->
        <aside class="docs-nav" aria-label="Documentation sections">
          <button class="docs-search-trigger" data-cmdk-open aria-label="Search docs">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="7"/><path d="M21 21l-4.3-4.3"/></svg>
            <span class="dst-label">Search docs…</span>
            <kbd class="dst-kbd"><span>⌘</span>K</kbd>
          </button>
          <div class="docs-mobile-bar">
            <span class="mb-now"><span class="mb-k">Docs</span> <span data-mb-now>Introduction</span></span>
            <svg class="mb-chev" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 9l6 6 6-6"/></svg>
          </div>
          <div class="docs-nav-inner">
            <div class="dn-group">
              <p class="dn-label">Getting started</p>
              <a class="dn-link" href="#introduction">Introduction</a>
              <a class="dn-link" href="#install">Installation</a>
              <a class="dn-link" href="#first-run">First run</a>
            </div>
            <div class="dn-group">
              <p class="dn-label">Operating</p>
              <a class="dn-link" href="#configuration">Configuration</a>
              <a class="dn-link" href="#git-access">Git access</a>
              <a class="dn-link" href="#reverse-proxy">Reverse proxy &amp; TLS</a>
            </div>
            <div class="dn-group">
              <p class="dn-label">Administration</p>
              <a class="dn-link" href="#backups">Backups</a>
              <a class="dn-link" href="#upgrading">Upgrading</a>
            </div>
            <div class="dn-group">
              <p class="dn-label">Reference</p>
              <a class="dn-link" href={LINKS.github} target="_blank" rel="noopener">GitHub repo ↗</a>
              <a class="dn-link" href={LINKS.changelog}>Changelog</a>
            </div>
          </div>
        </aside>

        <!-- center: article -->
        <article class="docs-article">
          <p class="docs-kicker">Getting started</p>
          <h1 class="docs-h1">Self-host Cloudzilla</h1>
          <p class="docs-lede">Cloudzilla is a single static binary backed by PostgreSQL. There is no <code class="ic">git</code> executable to install, no message queue, and no separate search service — this guide takes you from a fresh host to a running forge.</p>

          <!-- Introduction -->
          <section class="docs-section" id="introduction">
            <h2>Introduction</h2>
            <p>Everything Cloudzilla needs at runtime is the binary itself and a PostgreSQL database. Git transport (smart HTTP and SSH) is implemented in pure Go via <code class="ic">go-git</code>, full-text search runs on Postgres <code class="ic">tsvector</code>, and the UI is server-rendered HTML over the wire. That means a deployment is two moving parts you already know how to operate.</p>
            <div class="callout tip">
              <span class="co-ico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 18h6M10 22h4M12 2a7 7 0 0 0-4 12.7c.6.5 1 1.3 1 2.1h6c0-.8.4-1.6 1-2.1A7 7 0 0 0 12 2z"/></svg></span>
              <p><strong>In a hurry?</strong> Skip to <a class="ilink" href="#install">Installation</a> — Docker plus a <code class="ic">DATABASE_URL</code> is enough to get a forge on port <code class="ic">3000</code>.</p>
            </div>
            <h3>What you'll need</h3>
            <ul class="dl">
              <li>A Linux host (amd64 or arm64), or Docker on any platform.</li>
              <li><strong>PostgreSQL 14+</strong> — managed or self-run; it's the only runtime dependency.</li>
              <li>Two open ports: one for HTTP (default <code class="ic">3000</code>) and one for SSH Git access (default <code class="ic">22</code>).</li>
            </ul>
          </section>

          <!-- Installation -->
          <section class="docs-section" id="install">
            <h2>Installation</h2>
            <p>Pick whichever fits your stack. All three give you the same single binary — Docker is the fastest path to a running instance.</p>

            <h3>Docker</h3>
            <p>Pull the alpha image and point it at a database. Cloudzilla runs migrations on boot, so the database only needs to exist and be reachable.</p>
            <CodeBlock caption="docker" copy={cbDocker.copy} html={cbDocker.html} />

            <h3>Docker Compose</h3>
            <p>If you want Postgres alongside it, this is the whole stack:</p>
            <CodeBlock caption="docker-compose.yml" copy={cbCompose.copy} html={cbCompose.html} />

            <h3>Prebuilt binary</h3>
            <p>Grab a release artifact, drop it on the host, and run it. No libraries to link, no runtime to install.</p>
            <CodeBlock caption="binary" copy={cbBinary.copy} html={cbBinary.html} />
          </section>

          <!-- First run -->
          <section class="docs-section" id="first-run">
            <h2>First run</h2>
            <p>On its first boot against an empty database, Cloudzilla applies migrations and then waits for you to create the first account.</p>
            <ol class="docs-steps">
              <li><strong>Open the instance.</strong> Visit <code class="ic">http://localhost:3000</code>. You'll land on the setup screen.</li>
              <li><strong>Create the admin.</strong> The first registered user becomes the instance owner — full admin rights, including user and org management.</li>
              <li><strong>Add an SSH key.</strong> Under <em>Settings → SSH keys</em>, paste your public key so you can push over SSH. See <a class="ilink" href="#git-access">Git access</a>.</li>
              <li><strong>Create a repository</strong> and push your first commit. That's a working forge.</li>
            </ol>
            <div class="callout note">
              <span class="co-ico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M12 16v-4M12 8h.01"/></svg></span>
              <p>You can also pre-seed an admin non-interactively with <code class="ic">cloudzilla admin create --email you@example.com</code> — handy for automated provisioning.</p>
            </div>
          </section>

          <!-- Configuration -->
          <section class="docs-section" id="configuration">
            <h2>Configuration</h2>
            <p>Cloudzilla is configured entirely through environment variables — no config file to template, no secrets baked into an image. The essentials:</p>
            <table class="opt-table">
              <thead>
                <tr><th>Variable</th><th>Description</th><th>Default</th></tr>
              </thead>
              <tbody>
                <tr>
                  <td class="k"><code class="ic">DATABASE_URL</code></td>
                  <td class="d">PostgreSQL connection string. <span class="req">required</span></td>
                  <td class="def">—</td>
                </tr>
                <tr>
                  <td class="k"><code class="ic">CLOUDZILLA_BASE_URL</code></td>
                  <td class="d">Public URL of the instance. Used in clone URLs, webhooks, and OAuth callbacks.</td>
                  <td class="def">http://localhost:3000</td>
                </tr>
                <tr>
                  <td class="k"><code class="ic">HTTP_ADDR</code></td>
                  <td class="d">Address the web server binds to.</td>
                  <td class="def">:3000</td>
                </tr>
                <tr>
                  <td class="k"><code class="ic">SSH_ADDR</code></td>
                  <td class="d">Address the built-in Git SSH server binds to.</td>
                  <td class="def">:22</td>
                </tr>
                <tr>
                  <td class="k"><code class="ic">SECRET_KEY</code></td>
                  <td class="d">Signing key for session cookies and tokens. <span class="req">set in prod</span></td>
                  <td class="def">random</td>
                </tr>
                <tr>
                  <td class="k"><code class="ic">DISABLE_SIGNUP</code></td>
                  <td class="d">When <code class="ic">true</code>, new accounts can only be created by an admin.</td>
                  <td class="def">false</td>
                </tr>
              </tbody>
            </table>
            <div class="callout warn">
              <span class="co-ico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10.3 3.9 1.8 18a2 2 0 0 0 1.7 3h17a2 2 0 0 0 1.7-3L13.7 3.9a2 2 0 0 0-3.4 0z"/><path d="M12 9v4M12 17h.01"/></svg></span>
              <p>Always set <code class="ic">SECRET_KEY</code> to a fixed value in production. If it's left to randomize, every restart invalidates active sessions and signed tokens.</p>
            </div>
          </section>

          <!-- Git access -->
          <section class="docs-section" id="git-access">
            <h2>Git access</h2>
            <p>Cloudzilla speaks both smart HTTP and SSH out of the box, both implemented in pure Go. There is no system <code class="ic">git</code> binary involved on the server side.</p>
            <h3>Over SSH</h3>
            <p>Add your public key under <em>Settings → SSH keys</em>, then clone using the instance's SSH port:</p>
            <CodeBlock caption="clone over ssh" copy={cbSsh.copy} html={cbSsh.html} />
            <h3>Over HTTPS</h3>
            <p>Use a <strong>personal access token</strong> as the password — generate one under <em>Settings → Tokens</em>. Tokens can be scoped read-only or read/write per repository.</p>
            <CodeBlock caption="clone over https" copy={cbHttps.copy} html={cbHttps.html} />
          </section>

          <!-- Reverse proxy -->
          <section class="docs-section" id="reverse-proxy">
            <h2>Reverse proxy &amp; TLS</h2>
            <p>For production, terminate TLS at a reverse proxy and forward HTTP traffic to Cloudzilla. SSH stays a direct TCP passthrough on its own port. A minimal Caddy config:</p>
            <CodeBlock caption="Caddyfile" copy={cbCaddy.copy} html={cbCaddy.html} />
            <div class="callout note">
              <span class="co-ico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M12 16v-4M12 8h.01"/></svg></span>
              <p>Set <code class="ic">CLOUDZILLA_BASE_URL</code> to the public HTTPS URL so generated clone links, webhooks, and OAuth callbacks point at the proxy rather than the internal port.</p>
            </div>
          </section>

          <!-- Backups -->
          <section class="docs-section" id="backups">
            <h2>Backups</h2>
            <p>Because all state — repositories, issues, users, settings — lives in PostgreSQL and on the repository volume, a backup is two things: a database dump and the data directory.</p>
            <ul class="dl">
              <li><strong>Database:</strong> a regular <code class="ic">pg_dump</code> of the Cloudzilla database captures all metadata and search indexes.</li>
              <li><strong>Repositories:</strong> snapshot the configured <code class="ic">DATA_DIR</code> (the volume holding Git object storage).</li>
            </ul>
            <CodeBlock caption="nightly dump" copy={cbBackup.copy} html={cbBackup.html} />
          </section>

          <!-- Upgrading -->
          <section class="docs-section" id="upgrading">
            <h2>Upgrading</h2>
            <p>Upgrades are a binary (or image tag) swap. On boot the new version applies any pending migrations forward; there's no separate migration step to run.</p>
            <ol class="docs-steps">
              <li><strong>Back up</strong> the database first — see <a class="ilink" href="#backups">Backups</a>.</li>
              <li><strong>Pull the new tag</strong> (e.g. bump <code class="ic">v0.3.0</code> → the next release) and restart the container or service.</li>
              <li><strong>Watch the logs</strong> — migrations are logged on startup and the instance reports <code class="ic">ready</code> when it's serving.</li>
            </ol>
            <div class="callout tip">
              <span class="co-ico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 18h6M10 22h4M12 2a7 7 0 0 0-4 12.7c.6.5 1 1.3 1 2.1h6c0-.8.4-1.6 1-2.1A7 7 0 0 0 12 2z"/></svg></span>
              <p>Cloudzilla is in alpha — read the <a class="ilink" href={LINKS.changelog}>changelog</a> before upgrading. Breaking changes are called out there per release.</p>
            </div>

            <!-- pager -->
            <nav class="docs-pager" aria-label="More">
              <a class="prev" href="/#quickstart">
                <div class="pg-dir">← Overview</div>
                <div class="pg-title">Quickstart on the landing page</div>
              </a>
              <a class="next" href={LINKS.changelog}>
                <div class="pg-dir">Next →</div>
                <div class="pg-title">Changelog</div>
              </a>
            </nav>
          </section>
        </article>

      </div><!-- /docs -->
    </div><!-- /wrap -->
  </main>

  <!-- command palette (⌘K) -->
  <div class="cmdk" id="cmdk" hidden>
    <div class="cmdk-scrim" data-cmdk-close></div>
    <div class="cmdk-panel" role="dialog" aria-modal="true" aria-label="Search documentation">
      <div class="cmdk-input-wrap">
        <svg class="cmdk-search-ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="7"/><path d="M21 21l-4.3-4.3"/></svg>
        <input class="cmdk-input" type="text" placeholder="Search the docs…" autocomplete="off" spellcheck="false" aria-label="Search query" />
        <kbd class="cmdk-esc">esc</kbd>
      </div>
      <div class="cmdk-results" role="listbox" aria-label="Results"></div>
      <div class="cmdk-foot">
        <span class="ck-hint"><kbd>↑</kbd><kbd>↓</kbd> navigate</span>
        <span class="ck-hint"><kbd>↵</kbd> open</span>
        <span class="ck-hint"><kbd>esc</kbd> close</span>
        <span class="ck-brand">cloudzilla docs</span>
      </div>
    </div>
  </div>

  <Footer />
</LandingLayout>

<script>
  import '../scripts/docs.ts';
</script>
