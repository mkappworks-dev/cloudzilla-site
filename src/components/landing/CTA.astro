---
import { DOCKER_PULL, LINKS } from '../../consts';
---
<section class="section-pad divide final">
  <div class="grid-fade" aria-hidden="true"></div>
  <div class="wrap" style="position:relative">
    <div class="reveal">
      <h2>Self-host Cloudzilla today.</h2>
      <p>One binary. PostgreSQL. Your infrastructure. Pull the alpha and have a forge running before your coffee's cold.</p>
      <div class="cmd">
        <div class="cmd-body">
          <span class="prompt">$</span>
          <code>{DOCKER_PULL}</code>
        </div>
        <button class="copy" data-copy={DOCKER_PULL} aria-label="Copy install command">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="9" y="9" width="11" height="11" rx="2"/><path d="M5 15V5a2 2 0 0 1 2-2h10"/></svg>
        </button>
      </div>
      <div class="final-cta">
        <a class="btn btn-primary" href="#quickstart">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
          Get started
        </a>
        <a class="btn btn-secondary" href={LINKS.github} target="_blank" rel="noopener">
          <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 1.5A10.5 10.5 0 0 0 8.7 22c.5.1.7-.2.7-.5v-1.8c-2.9.6-3.5-1.4-3.5-1.4-.5-1.2-1.2-1.5-1.2-1.5-1-.6 0-.6 0-.6 1 .1 1.6 1 1.6 1 .9 1.6 2.4 1.1 3 .9.1-.7.4-1.1.7-1.4-2.3-.3-4.7-1.2-4.7-5.1 0-1.1.4-2 1-2.7-.1-.3-.5-1.3.1-2.7 0 0 .8-.3 2.7 1a9.4 9.4 0 0 1 5 0c1.9-1.3 2.7-1 2.7-1 .6 1.4.2 2.4.1 2.7.6.7 1 1.6 1 2.7 0 3.9-2.4 4.8-4.7 5.1.4.3.7.9.7 1.9v2.8c0 .3.2.6.7.5A10.5 10.5 0 0 0 12 1.5z"/></svg>
          View on GitHub
        </a>
      </div>
    </div>
  </div>
</section>
