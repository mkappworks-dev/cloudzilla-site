---
<div class="footer-meta">
  <span class="lic">
    <span class="logo" aria-hidden="true"><svg viewBox="11 9 44 44" fill="currentColor"><circle cx="22" cy="36" r="9"/><circle cx="32" cy="28" r="11"/><circle cx="44" cy="36" r="9"/><rect x="22" y="36" width="22" height="9" rx="4.5"/></svg></span>
    © 2026 Cloudzilla. Licensed under BSL 1.1.
  </span>
  <span class="made">Created by <a href="https://mkappworks.com/" target="_blank" rel="noopener">mkappworks</a></span>
  <div class="footer-socials" aria-label="Social links">
    {socials.map((s) => (
      <a href={s.href} target="_blank" rel="noopener" aria-label={s.label}>
        <svg width="16" height="16" viewBox={s.viewBox} fill="currentColor" aria-hidden="true"><path d={s.icon}/></svg>
      </a>
    ))}
  </div>
</div>

<style>
  .footer-meta { display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; gap: 16px 24px; }
  .lic { justify-self: start; display: inline-flex; align-items: center; gap: 10px; font-size: 13px; color: hsl(var(--cz-faint)); }
  .lic .logo { flex-shrink: 0; display: grid; place-items: center; color: hsl(var(--cz-fg)); }
  .lic .logo svg { width: 19px; height: 19px; }
  .made { justify-self: center; font-size: 13px; color: hsl(var(--cz-faint)); font-family: var(--cz-font-mono); }
  .made a { color: hsl(var(--cz-muted-foreground)); transition: color .15s; }
  .made a:hover { color: hsl(var(--cz-fg)); }
  .footer-socials { justify-self: end; display: inline-flex; align-items: center; gap: 8px; }
  .footer-socials a { display: inline-flex; align-items: center; justify-content: center; width: 30px; height: 30px; border-radius: 7px; color: hsl(var(--cz-faint)); transition: color .15s, background .15s; }
  .footer-socials a:hover { color: hsl(var(--cz-fg)); background: hsl(var(--cz-card-raised)); }
  @media (max-width: 560px) {
    .footer-meta { grid-template-columns: 1fr; justify-items: center; text-align: center; gap: 18px; }
    .lic, .made, .footer-socials { justify-self: center; }
  }
</style>
