---
// A captioned, copyable code block for the docs page.
// `html` is the pre-highlighted inner markup (with .c-prompt/.c-flag/.c-str/
// .c-comment spans) and is injected via set:html so literal braces in the
// snippet (e.g. a Caddyfile) don't collide with Astro's `{ }` expressions.
// `copy` is the raw text placed on the clipboard; interactions.ts wires it.
// The copy button sits inside the caption bar — right-aligned, vertically
// centered — so it reads as a proper code-window toolbar.
interface Props { caption: string; copy: string; html: string; }
const { caption, copy, html } = Astro.props;
---
<div class="code-block">
  <div class="code-caption">
    <span class="cc-dot"></span>
    <span class="cc-name">{caption}</span>
    <button class="code-copy" data-copy={copy} aria-label="Copy code">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="9" y="9" width="11" height="11" rx="2"/><path d="M5 15V5a2 2 0 0 1 2-2h10"/></svg>
      <span data-copy-label>Copy</span>
    </button>
  </div>
  <pre set:html={html}></pre>
</div>
