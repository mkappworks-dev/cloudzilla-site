---
import LandingLayout from '../layouts/LandingLayout.astro';
import Nav from '../components/landing/Nav.astro';
import Footer from '../components/landing/Footer.astro';
import { LINKS } from '../consts';
import '../styles/status.css';
---
<LandingLayout title="Server error" description="The server hit an unexpected error." noindex>
  <div class="status-page">
    <Nav />
    <main id="main" class="status-main is-err">
      <div class="grid-fade" aria-hidden="true"></div>
      <div class="status-inner">
        <span class="status-badge err"><span class="sb-dot"></span> Error · 500</span>
        <p class="status-code"><span class="glow">5</span>0<span class="glow">0</span></p>
        <h1 class="status-h1">Something broke on our end.</h1>
        <p class="status-sub">The server hit an unexpected error and couldn't complete your request. It's not you — the instance logged it. Try again in a moment.</p>

        <div class="status-term" aria-hidden="true">
          <div class="st-bar"><i></i><i></i><i></i><span class="st-name">cloudzilla · serve</span></div>
          <div class="st-body">
            <div class="ln"><span class="p">$</span> cloudzilla serve <span class="dim">--env=production</span></div>
            <div class="ln"><span class="err">error:</span> <span class="dim">internal — request aborted</span> <span class="white">(ref a1f9c3e)</span></div>
            <div class="ln"><span class="dim">→ event logged · retry is safe</span></div>
          </div>
        </div>

        <div class="status-cta">
          <button class="btn btn-primary" onclick="location.reload()">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 12a9 9 0 1 0 3-6.7L3 8M3 3v5h5"/></svg>
            Try again
          </button>
          <a class="btn btn-secondary" href="/">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 11l9-8 9 8M5 10v10a1 1 0 0 0 1 1h4v-6h4v6h4a1 1 0 0 0 1-1V10"/></svg>
            Go home
          </a>
        </div>

        <div class="status-links">
          <a href={`${LINKS.github}/issues`} target="_blank" rel="noopener"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M12 8v4M12 16h.01"/></svg> Report an issue</a>
          <a href={LINKS.docs}><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/></svg> Docs</a>
          <a href={LINKS.github} target="_blank" rel="noopener"><svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 1.5A10.5 10.5 0 0 0 8.7 22c.5.1.7-.2.7-.5v-1.8c-2.9.6-3.5-1.4-3.5-1.4-.5-1.2-1.2-1.5-1.2-1.5-1-.6 0-.6 0-.6 1 .1 1.6 1 1.6 1 .9 1.6 2.4 1.1 3 .9.1-.7.4-1.1.7-1.4-2.3-.3-4.7-1.2-4.7-5.1 0-1.1.4-2 1-2.7-.1-.3-.5-1.3.1-2.7 0 0 .8-.3 2.7 1a9.4 9.4 0 0 1 5 0c1.9-1.3 2.7-1 2.7-1 .6 1.4.2 2.4.1 2.7.6.7 1 1.6 1 2.7 0 3.9-2.4 4.8-4.7 5.1.4.3.7.9.7 1.9v2.8c0 .3.2.6.7.5A10.5 10.5 0 0 0 12 1.5z"/></svg> GitHub</a>
        </div>
      </div>
    </main>
    <Footer />
  </div>
</LandingLayout>
