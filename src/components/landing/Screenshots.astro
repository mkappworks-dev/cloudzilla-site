---
import { SHOTS } from '../../consts';
import Carousel from './Carousel.astro';
---
<section class="container py-20">
  <h2 class="text-center text-3xl font-bold tracking-tight">A familiar, fast interface</h2>
  <p class="mx-auto mt-3 max-w-xl text-center text-muted-foreground">
    Everything you expect from a modern forge — dashboards, code review, project boards,
    discussions, and releases — rendered server-side and fast by default.
  </p>
  <div class="mt-12">
    <Carousel shots={SHOTS} />
  </div>
</section>
