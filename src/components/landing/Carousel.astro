---
interface Shot {
  src: string;
  alt: string;
  caption: string;
}
interface Props {
  shots: Shot[];
}
const { shots } = Astro.props;
---
<div
  class="carousel relative mx-auto max-w-5xl"
  role="region"
  aria-roledescription="carousel"
  aria-label="Product screenshots"
>
  <ul
    class="carousel-track flex snap-x snap-mandatory gap-4 overflow-x-auto scroll-smooth pb-1 [-ms-overflow-style:none] [scrollbar-width:none] [&::-webkit-scrollbar]:hidden"
  >
    {
      shots.map((s, i) => (
        <li
          class="carousel-slide shrink-0 basis-full snap-center"
          role="group"
          aria-roledescription="slide"
          aria-label={`${i + 1} of ${shots.length}`}
        >
          <figure class="overflow-hidden rounded-xl border border-border bg-card">
            <img
              src={s.src}
              alt={s.alt}
              width="1440"
              height="900"
              loading={i === 0 ? 'eager' : 'lazy'}
              class="aspect-[16/10] w-full object-cover object-top"
            />
          </figure>
        </li>
      ))
    }
  </ul>

  <button
    type="button"
    class="carousel-prev absolute left-3 top-[42%] grid h-10 w-10 -translate-y-1/2 place-items-center rounded-full border border-border bg-card/80 text-lg backdrop-blur transition hover:bg-muted disabled:opacity-30"
    aria-label="Previous screenshot"
  >
    ‹
  </button>
  <button
    type="button"
    class="carousel-next absolute right-3 top-[42%] grid h-10 w-10 -translate-y-1/2 place-items-center rounded-full border border-border bg-card/80 text-lg backdrop-blur transition hover:bg-muted disabled:opacity-30"
    aria-label="Next screenshot"
  >
    ›
  </button>

  <p class="carousel-caption mt-5 text-center text-sm text-muted-foreground" aria-live="polite">
    {shots[0].caption}
  </p>

  <div class="mt-4 flex items-center justify-center gap-2">
    {
      shots.map((s, i) => (
        <button
          type="button"
          class="carousel-dot h-2 w-2 rounded-full bg-border-strong transition-all aria-[current=true]:w-5 aria-[current=true]:bg-foreground"
          data-index={i}
          aria-current={i === 0 ? 'true' : 'false'}
          aria-label={`Show: ${s.caption}`}
        />
      ))
    }
  </div>
</div>

<script>
  const CAPTIONS = [
    'Dashboard — repos, activity, and stats at a glance',
    'Code browser — files, blame, and commit history',
    'Pull requests — reviews, merge strategies, and checks',
    'Code review — inline comments and one-click suggestions',
    'Issues — labels, assignees, milestones, and timelines',
    'Project boards — Kanban planning and milestones',
    'Discussions — community Q&A and announcements',
    'Releases — tagged versions with changelogs',
  ];

  document.querySelectorAll<HTMLElement>('.carousel').forEach((root) => {
    const track = root.querySelector<HTMLElement>('.carousel-track');
    const slides = [...root.querySelectorAll<HTMLElement>('.carousel-slide')];
    const dots = [...root.querySelectorAll<HTMLElement>('.carousel-dot')];
    const caption = root.querySelector<HTMLElement>('.carousel-caption');
    const prev = root.querySelector<HTMLButtonElement>('.carousel-prev');
    const next = root.querySelector<HTMLButtonElement>('.carousel-next');
    if (!track || slides.length === 0) return;

    let current = 0;

    const go = (i: number) => {
      const n = Math.max(0, Math.min(slides.length - 1, i));
      // rect math keeps the page from scrolling vertically and respects gaps
      const left =
        slides[n].getBoundingClientRect().left -
        track.getBoundingClientRect().left +
        track.scrollLeft;
      track.scrollTo({ left, behavior: 'smooth' });
    };

    const sync = (i: number) => {
      current = i;
      dots.forEach((d, di) => d.setAttribute('aria-current', String(di === i)));
      if (caption) caption.textContent = CAPTIONS[i] ?? '';
      if (prev) prev.disabled = i === 0;
      if (next) next.disabled = i === slides.length - 1;
    };

    prev?.addEventListener('click', () => go(current - 1));
    next?.addEventListener('click', () => go(current + 1));
    dots.forEach((d) =>
      d.addEventListener('click', () => go(Number(d.dataset.index))),
    );

    const io = new IntersectionObserver(
      (entries) => {
        entries.forEach((e) => {
          if (e.isIntersecting) sync(slides.indexOf(e.target as HTMLElement));
        });
      },
      { root: track, threshold: 0.6 },
    );
    slides.forEach((s) => io.observe(s));

    sync(0);
  });
</script>
