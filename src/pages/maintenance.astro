---
import LandingLayout from '../layouts/LandingLayout.astro';
import FooterMeta from '../components/FooterMeta.astro';
import { LINKS } from '../consts';
import '../styles/status.css';
// Slim brand-only chrome (no full nav) — during real downtime the rest of
// the site is unavailable, so there's nowhere to navigate. Reuses status.css.
---
<LandingLayout title="Down for maintenance" description="Cloudzilla is briefly offline for a scheduled update.">
  <div class="status-page">
    <header class="status-head">
      <div class="wrap">
        <a class="brand" href="/" aria-label="Cloudzilla home">
          <span class="logo" aria-hidden="true"><svg viewBox="11 9 44 44" fill="currentColor"><circle cx="22" cy="36" r="9"/><circle cx="32" cy="28" r="11"/><circle cx="44" cy="36" r="9"/><rect x="22" y="36" width="22" height="9" rx="4.5"/></svg></span>
          <span class="name">cloudzilla</span>
        </a>
      </div>
    </header>

    <main id="main" class="status-main">
      <div class="grid-fade" aria-hidden="true"></div>
      <div class="status-inner">
        <span class="status-badge warn"><span class="sb-dot"></span> Scheduled maintenance</span>
        <p class="status-code"><span class="glow">5</span>0<span class="glow">3</span></p>
        <h1 class="status-h1">Down for maintenance.</h1>
        <p class="status-sub">We're applying an update and will be back shortly. Your data is safe — this is planned downtime, not an outage.</p>

        <div class="status-term" aria-hidden="true">
          <div class="st-bar"><i></i><i></i><i></i><span class="st-name">cloudzilla · maintenance</span></div>
          <div class="st-body">
            <div class="ln"><span class="p">$</span> cloudzilla maintenance <span class="dim">--reason="applying migrations"</span></div>
            <div class="ln"><span class="dim">info: instance paused · 503 Service Unavailable</span></div>
            <div class="ln"><span class="dim">→ back shortly · no action needed</span></div>
          </div>
        </div>

        <div class="status-cta">
          <button class="btn btn-primary" onclick="location.reload()">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 12a9 9 0 1 0 3-6.7L3 8M3 3v5h5"/></svg>
            Check again
          </button>
        </div>

        <div class="status-links">
          <a href={`${LINKS.github}/issues`} target="_blank" rel="noopener"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M12 8v4M12 16h.01"/></svg> Status &amp; updates</a>
          <a href={LINKS.changelog}><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 8v4l3 2"/><circle cx="12" cy="12" r="9"/></svg> Changelog</a>
          <a href={LINKS.github} target="_blank" rel="noopener"><svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 1.5A10.5 10.5 0 0 0 8.7 22c.5.1.7-.2.7-.5v-1.8c-2.9.6-3.5-1.4-3.5-1.4-.5-1.2-1.2-1.5-1.2-1.5-1-.6 0-.6 0-.6 1 .1 1.6 1 1.6 1 .9 1.6 2.4 1.1 3 .9.1-.7.4-1.1.7-1.4-2.3-.3-4.7-1.2-4.7-5.1 0-1.1.4-2 1-2.7-.1-.3-.5-1.3.1-2.7 0 0 .8-.3 2.7 1a9.4 9.4 0 0 1 5 0c1.9-1.3 2.7-1 2.7-1 .6 1.4.2 2.4.1 2.7.6.7 1 1.6 1 2.7 0 3.9-2.4 4.8-4.7 5.1.4.3.7.9.7 1.9v2.8c0 .3.2.6.7.5A10.5 10.5 0 0 0 12 1.5z"/></svg> GitHub</a>
        </div>
      </div>
    </main>

    <footer class="status-foot">
      <div class="wrap">
        <FooterMeta />
      </div>
    </footer>
  </div>
</LandingLayout>
