---
import { LINKS } from '../../consts';
// Section links use absolute "/#id" so they resolve from any page
// (e.g. the changelog) and still scroll on the landing page itself.
---
<header class="nav">
  <div class="wrap nav-inner">
    <a class="brand" href="/" aria-label="Cloudzilla home">
      <span class="logo" aria-hidden="true">
        <svg viewBox="11 9 44 44" fill="currentColor"><circle cx="22" cy="36" r="9"/><circle cx="32" cy="28" r="11"/><circle cx="44" cy="36" r="9"/><rect x="22" y="36" width="22" height="9" rx="4.5"/></svg>
      </span>
      <span class="name">cloudzilla</span>
    </a>
    <nav class="nav-links" aria-label="Primary">
      <a href="/#features">Features</a>
      <a href="/#architecture">Architecture</a>
      <a href="/#quickstart">Quickstart</a>
      <a href="/#roadmap">Roadmap</a>
    </nav>
    <div class="nav-right">
      <a class="star-ask" href={LINKS.github} target="_blank" rel="noopener">
        <svg viewBox="0 0 24 24" width="13" height="13" fill="currentColor" aria-hidden="true"><path d="M12 2l2.9 6.3 6.9.7-5.1 4.7 1.4 6.8L12 17.8 5.9 20.5 7.3 13.7 2.2 9l6.9-.7L12 2z"/></svg>
        Star us
      </a>
      <span class="star-cta">
        <a class="star-main" href={LINKS.github} target="_blank" rel="noopener" aria-label="View on GitHub">
          <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor" aria-hidden="true"><path d="M12 1.5A10.5 10.5 0 0 0 8.7 22c.5.1.7-.2.7-.5v-1.8c-2.9.6-3.5-1.4-3.5-1.4-.5-1.2-1.2-1.5-1.2-1.5-1-.6 0-.6 0-.6 1 .1 1.6 1 1.6 1 .9 1.6 2.4 1.1 3 .9.1-.7.4-1.1.7-1.4-2.3-.3-4.7-1.2-4.7-5.1 0-1.1.4-2 1-2.7-.1-.3-.5-1.3.1-2.7 0 0 .8-.3 2.7 1a9.4 9.4 0 0 1 5 0c1.9-1.3 2.7-1 2.7-1 .6 1.4.2 2.4.1 2.7.6.7 1 1.6 1 2.7 0 3.9-2.4 4.8-4.7 5.1.4.3.7.9.7 1.9v2.8c0 .3.2.6.7.5A10.5 10.5 0 0 0 12 1.5z"/></svg>
        </a>
      </span>
    </div>
  </div>
</header>
